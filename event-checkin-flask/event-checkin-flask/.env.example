# PostgreSQL (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Credenziali applicazione: devono essere diverse
ADMIN_PASSWORD=imposta-una-password-admin
STATION_PASSWORD=imposta-una-password-operatori
SECRET_KEY=inserisci-una-chiave-casuale-lunga

# Telegram (facoltativo)
TG_TOKEN=
TG_CHAT_ID=

# Neon Object Storage S3 (facoltativo, per backup cloud)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
